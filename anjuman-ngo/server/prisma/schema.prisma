generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}


datasource db {
  provider = "postgresql"
}


/* =========================================================
   ENUMS
========================================================= */

enum Role {
  USER
  ADMIN
}


enum Branch {
  NAGPADA
  DHARAVI
}


enum ApplicationType {
  MEDICAL
  SCHOLARSHIP
  LIVELIHOOD
  TRAVEL
}


enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}


enum DocumentType {
  IDENTITY
  SUPPORTING
  MEDICAL
  EDUCATION
  INCOME
  TRAVEL
  OTHER
}


enum DonationMethod {
  UPI
  RAZORPAY
}


enum DonationStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}


/* =========================================================
   USER
========================================================= */

model User {
  id           String   @id @default(cuid())

  name         String

  username     String   @unique

  email        String   @unique

  phone        String?

  passwordHash String

  role         Role     @default(USER)

  isActive     Boolean  @default(true)

  applications Application[]

  donations    Donation[]

  statusChanges ApplicationStatusHistory[] @relation("StatusChangedBy")

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt


  @@index([role])
  @@index([createdAt])
}


/* =========================================================
   APPLICATION
========================================================= */

model Application {
  id              String            @id @default(cuid())

  referenceNumber String            @unique

  userId          String

  type            ApplicationType

  branch          Branch

  status          ApplicationStatus @default(PENDING)


  /* Applicant information */

  applicantName   String

  phone           String

  email           String?

  age             Int?

  address         String            @db.Text

  city            String?

  pincode         String?


  /* Request */

  description     String            @db.Text

  details         Json


  /* Admin */

  adminNote       String?           @db.Text


  /* Relations */

  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  documents       ApplicationDocument[]

  statusHistory   ApplicationStatusHistory[]


  createdAt       DateTime          @default(now())

  updatedAt       DateTime          @updatedAt


  @@index([userId, createdAt])

  @@index([branch, status])

  @@index([type, status])

  @@index([createdAt])
}


/* =========================================================
   APPLICATION DOCUMENT
========================================================= */

model ApplicationDocument {
  id            String       @id @default(cuid())

  applicationId String

  type          DocumentType

  originalName  String

  storageKey    String       @unique

  mimeType      String

  size          Int


  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)


  createdAt     DateTime     @default(now())


  @@index([applicationId])
}


/* =========================================================
   APPLICATION STATUS HISTORY
========================================================= */

model ApplicationStatusHistory {
  id            String            @id @default(cuid())

  applicationId String

  fromStatus    ApplicationStatus?

  toStatus      ApplicationStatus

  note          String?           @db.Text

  changedById   String?


  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  changedBy     User?             @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)


  createdAt     DateTime          @default(now())


  @@index([applicationId, createdAt])

  @@index([changedById])
}


/* =========================================================
   DONATION
========================================================= */

model Donation {
  id                 String         @id @default(cuid())

  userId             String?


  donorName          String?

  email              String?

  phone              String?


  amount             Decimal        @db.Decimal(12, 2)

  currency           String         @default("INR")

  method             DonationMethod

  status             DonationStatus @default(PENDING)


  /* Razorpay */

  razorpayOrderId    String?        @unique

  razorpayPaymentId  String?        @unique

  razorpaySignature  String?


  /* Manual / direct UPI verification */

  upiReference       String?        @unique

  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)


  createdAt          DateTime       @default(now())

  updatedAt          DateTime       @updatedAt


  @@index([userId])

  @@index([status, createdAt])

  @@index([method])
}