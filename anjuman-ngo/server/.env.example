# ==========================================================
# APPLICATION
# ==========================================================

NODE_ENV=development
PORT=5500


# ==========================================================
# DATABASE
# ==========================================================

DATABASE_URL="postgresql://anjuman_app:password@localhost:5432/anjuman_ngo"


# ==========================================================
# CLIENT / CORS
# ==========================================================

CLIENT_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"


# ==========================================================
# AUTHENTICATION
#
# Generate a long random JWT_SECRET in the real .env file.
# Never commit your actual production secret.
# ==========================================================

JWT_SECRET=
JWT_COOKIE_NAME=anjuman_session


# ==========================================================
# ADMIN SEED ACCOUNT
#
# Used when creating/seeding the initial administrator.
# Keep real credentials only in .env.
# ==========================================================

ADMIN_NAME=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=


# ==========================================================
# UPI
# ==========================================================

UPI_ID="your-official-upi-id"
UPI_PAYEE_NAME="Anjuman Bashindgan-E-Bihar"


# ==========================================================
# RAZORPAY
#
# Use test credentials during development.
# Never commit live secret keys.
# ==========================================================

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=